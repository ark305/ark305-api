{
  "name": "ark305-api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "test": "npm run build && node --test test/app.test.cjs test/auth.test.cjs test/requests.test.cjs test/ai.test.cjs",
    "test:rls": "node test/requests-rls.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "tsc-watch": "7.2.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
