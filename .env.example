# Mismo proyecto Supabase de la web. Solo clave publica publishable, nunca service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# IA en Nest: configurar secretos solo en el entorno privado del backend.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai
# META_MODEL_QUICK=muse-spark-1.3
AI_DAILY_LIMIT=60

# Dedicated random secret (minimum 32 characters). Keep stable to verify saved team proposals.
TEAM_PROPOSAL_SIGNING_KEY=

# GoHighLevel API v2 (sub-account Private Integration Token). Backend only; never expose to Next or the browser.
GHL_API_KEY=
GHL_LOCATION_ID=
# Pipeline/stage for service-order opportunities (stage optional: GHL uses the pipeline's first stage).
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# GHL_BASE_URL=https://services.leadconnectorhq.com
